<% if (success && success.length) { %>

    <div class="d-flex justify-content-center mt-3">

        <div
            class="alert alert-success alert-dismissible fade show w-50 text-center"
            role="alert"
        >

            <%= success %>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"
            ></button>

        </div>

    </div>

<% } %>


<% if (error && error.length) { %>

    <div class="d-flex justify-content-center mt-3">

        <div
            class="alert alert-danger alert-dismissible fade show w-50 text-center"
            role="alert"
        >

            <%= error %>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"
            ></button>

        </div>

    </div>

<% } %>