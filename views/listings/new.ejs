<% layout("layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-8 offset-2">

        <h3 class="mb-4">Give details about Property</h3>


        <form
            action="/listings"
            method="POST"
            class="needs-validation"
            novalidate
            enctype="multipart/form-data"
        >


            <!-- Title -->
            <div class="mb-3">

                <label for="title" class="form-label">
                    Title
                </label>

                <input
                    type="text"
                    name="listing[title]"
                    placeholder="Enter title"
                    class="form-control"
                    id="title"
                    required
                >

                <div class="invalid-feedback">
                    Please enter Title.
                </div>

            </div>


            <!-- Description -->
            <div class="mb-3">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    placeholder="Enter description"
                    class="form-control"
                    id="description"
                    rows="5"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please add a short description.
                </div>

            </div>


            <!-- Category -->
            <div class="mb-3">

                <label for="listing-category" class="form-label">
                    Category
                </label>

                <select
                    name="listing[category]"
                    id="listing-category"
                    class="form-select listing-category-select"
                    required
                >

                    <option value="" selected disabled>
                        Select a category
                    </option>

                    <option value="Farms">Farms</option>
                    <option value="Rooms">Rooms</option>
                    <option value="Beach">Beach</option>
                    <option value="Mountain">Mountain</option>
                    <option value="Cabins">Cabins</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Amazing Views">Amazing Views</option>
                    <option value="Lakefront">Lakefront</option>
                    <option value="Iconic Cities">Iconic Cities</option>
                    <option value="Surfing">Surfing</option>
                    <option value="Camping">Camping</option>
                    <option value="Historic">Historic</option>

                </select>

                <div class="invalid-feedback">
                    Please select a category.
                </div>

            </div>


            <!-- Price + Location -->
            <div class="row">

                <!-- Price -->
                <div class="mb-3 col-md-4">

                    <label for="price" class="form-label">
                        Price
                    </label>

                    <input
                        type="number"
                        name="listing[price]"
                        placeholder="Enter Price"
                        class="form-control"
                        id="price"
                        min="0"
                        required
                    >

                    <div class="invalid-feedback">
                        Fill this field with a positive value.
                    </div>

                </div>


                <!-- Location -->
                <div class="mb-3 col-md-8">

                    <label for="location" class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        name="listing[location]"
                        placeholder="Enter Location"
                        class="form-control"
                        id="location"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter Location.
                    </div>

                </div>

            </div>


            <!-- Country -->
            <div class="mb-3">

                <label for="country" class="form-label">
                    Country
                </label>

                <input
                    type="text"
                    name="listing[country]"
                    placeholder="Enter Country"
                    class="form-control"
                    id="country"
                    required
                >

                <div class="invalid-feedback">
                    Please enter Country.
                </div>

            </div>


            <!-- Image -->
            <div class="mb-3">

                <label for="image" class="form-label">
                    Upload Listing Image
                </label>

                <input
                    type="file"
                    name="listing[image]"
                    class="form-control"
                    id="image"
                    required
                >

                <div class="invalid-feedback">
                    Please Upload Image of your Listing.
                </div>

            </div>


            <!-- Submit -->
            <button class="btn btn-dark add-btn">
                Submit
            </button>

        </form>

    </div>
</div>