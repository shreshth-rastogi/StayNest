<% layout("layouts/boilerplate.ejs") -%>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <h3 class="edit-page-title">
            Edit Your Listing
        </h3>


        <form
            action="/listings/<%= record._id %>?_method=PUT"
            method="POST"
            class="needs-validation"
            novalidate
            enctype="multipart/form-data"
        >


            <!-- Title -->
            <div class="mb-3">

                <label for="title" class="form-label">
                    Title
                </label>

                <input
                    type="text"
                    name="listing[title]"
                    value="<%= record.title %>"
                    class="form-control"
                    id="title"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a title.
                </div>

            </div>


            <!-- Description -->
            <div class="mb-3">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    class="form-control"
                    id="description"
                    required
                ><%= record.description %></textarea>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a description.
                </div>

            </div>


            <!-- Category -->
            <div class="mb-3">

                <label for="listing-category" class="form-label">
                    Category
                </label>

                <select
                    name="listing[category]"
                    id="listing-category"
                    class="form-select listing-category-select"
                    required
                >

                    <option value="" disabled>
                        Select a category
                    </option>

                    <option value="Farms" <%= record.category === "Farms" ? "selected" : "" %>>
                        Farms
                    </option>

                    <option value="Rooms" <%= record.category === "Rooms" ? "selected" : "" %>>
                        Rooms
                    </option>

                    <option value="Beach" <%= record.category === "Beach" ? "selected" : "" %>>
                        Beach
                    </option>

                    <option value="Mountain" <%= record.category === "Mountain" ? "selected" : "" %>>
                        Mountain
                    </option>

                    <option value="Cabins" <%= record.category === "Cabins" ? "selected" : "" %>>
                        Cabins
                    </option>

                    <option value="Amazing Pools" <%= record.category === "Amazing Pools" ? "selected" : "" %>>
                        Amazing Pools
                    </option>

                    <option value="Amazing Views" <%= record.category === "Amazing Views" ? "selected" : "" %>>
                        Amazing Views
                    </option>

                    <option value="Lakefront" <%= record.category === "Lakefront" ? "selected" : "" %>>
                        Lakefront
                    </option>

                    <option value="Iconic Cities" <%= record.category === "Iconic Cities" ? "selected" : "" %>>
                        Iconic Cities
                    </option>

                    <option value="Surfing" <%= record.category === "Surfing" ? "selected" : "" %>>
                        Surfing
                    </option>

                    <option value="Camping" <%= record.category === "Camping" ? "selected" : "" %>>
                        Camping
                    </option>

                    <option value="Historic" <%= record.category === "Historic" ? "selected" : "" %>>
                        Historic
                    </option>

                </select>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please select a category.
                </div>

            </div>


            <!-- Current Image -->
            <div class="mb-3">

                <label class="form-label">
                    Current Image
                </label>

                <div>

                    <img
                        src="<%= record.image.url %>"
                        alt="Current listing image"
                        class="edit-listing-image"
                    >

                </div>

            </div>


            <!-- Upload New Image -->
            <div class="mb-3">

                <label for="image" class="form-label">
                    Upload New Image
                </label>

                <input
                    type="file"
                    name="listing[image]"
                    class="form-control"
                    id="image"
                >

                <div class="form-text">
                    Leave this empty to keep the current image.
                </div>

            </div>


            <!-- Price -->
            <div class="mb-3">

                <label for="price" class="form-label">
                    Price
                </label>

                <input
                    type="number"
                    name="listing[price]"
                    value="<%= record.price %>"
                    class="form-control"
                    id="price"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>

            </div>


            <!-- Location -->
            <div class="mb-3">

                <label for="location" class="form-label">
                    Location
                </label>

                <input
                    type="text"
                    name="listing[location]"
                    value="<%= record.location %>"
                    class="form-control"
                    id="location"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a location.
                </div>

            </div>


            <!-- Country -->
            <div class="mb-3">

                <label for="country" class="form-label">
                    Country
                </label>

                <input
                    type="text"
                    name="listing[country]"
                    value="<%= record.country %>"
                    class="form-control"
                    id="country"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a country.
                </div>

            </div>


            <!-- Submit -->
            <button class="btn edit-btn">
                Edit Listing
            </button>

        </form>

    </div>
</div>