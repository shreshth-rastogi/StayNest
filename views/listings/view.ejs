<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h3 class="mb-4">
            Listing Details
        </h3>


        <!-- Listing Card -->
        <div class="card show-card">

            <img
                src="<%= result.image.url %>"
                class="card-img-top"
                alt="Listing image"
            >

            <div class="card-body">

                <!-- Owner -->
                <div class="owner-info">
                    <i class="fa-regular fa-user"></i>

                    <span>
                        Owned by <b><%= result.owner.username %></b>
                    </span>
                </div>


                <!-- Listing Information -->
                <div class="listing-info">

                    <!-- Title -->
                    <h2 class="listing-title">
                        <%= result.title %>
                    </h2>


                    <!-- Category -->
                    <div class="listing-category-display">
                        <i class="fa-solid fa-tag"></i>

                        <span>
                            <%= result.category %>
                        </span>
                    </div>


                    <!-- Description -->
                    <p class="listing-description">
                        <%= result.description %>
                    </p>


                    <!-- Price -->
                    <p class="listing-price">
                        &#8377;
                        <b><%= result.price.toLocaleString("en-IN") %></b>
                        <span>/ night</span>
                    </p>


                    <!-- Location -->
                    <p class="listing-location">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= result.location %>,
                        <%= result.country %>
                    </p>

                </div>

            </div>
        </div>


        <!-- Give Review Section -->
        <% if (user && !result.owner._id.equals(user._id)) { %>

            <div class="review-form-section mt-5">

                <h3 class="mb-4">
                    Give a Review
                </h3>


                <form
                    action="/listings/<%= result._id %>/reviews"
                    method="POST"
                    class="needs-validation"
                    novalidate
                >

                    <!-- Rating -->
                    <div class="mb-3">

                        <fieldset class="starability-fade">

                            <legend>
                                Rating:
                            </legend>


                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="0"
                                checked
                                aria-label="No rating."
                            />


                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                            />

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>


                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>

                        </fieldset>

                    </div>


                    <!-- Comment -->
                    <div class="mb-3">

                        <label
                            for="comment"
                            class="form-label"
                        >
                            Comments
                        </label>


                        <textarea
                            name="review[comment]"
                            class="form-control"
                            id="comment"
                            rows="5"
                            placeholder="Write your review here"
                            required
                        ></textarea>


                        <div class="invalid-feedback">
                            Please write some review.
                        </div>

                    </div>


                    <!-- Submit Review -->
                    <button
                        type="submit"
                        class="btn btn-dark add-btn mt-3 mb-5"
                    >
                        Submit Review
                    </button>

                </form>

            </div>

        <% } %>


        <!-- Show Reviews Section -->
        <div class="reviews-section mt-0">

            <h3 class="mb-4">
                All Reviews
            </h3>


            <% if (result.reviews.length > 0) { %>

                <div class="row">

                    <% for (let review of result.reviews) { %>

                        <div class="col-md-6 mb-3">

                            <div class="card review-card h-100">

                                <div class="card-body review-card-body">

                                    <!-- Review Author -->
                                    <div class="review-author">

                                        <i class="fa-regular fa-user"></i>

                                        <span>
                                            <b>
                                                <%= review.author.username %>
                                            </b>
                                        </span>

                                    </div>


                                    <!-- Rating -->
                                    <p
                                        class="starability-result"
                                        data-rating="<%= review.rating %>"
                                    >
                                        Rated:
                                        <%= review.rating %> stars
                                    </p>


                                    <!-- Comment -->
                                    <p class="card-text review-comment">
                                        <%= review.comment %>
                                    </p>


                                    <!-- Delete Review -->
                                    <form
                                        action="/listings/<%= result._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST"
                                    >

                                        <button class="btn btn-dark">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            <% } else { %>

                <p class="text-muted">
                    No reviews yet.
                </p>

            <% } %>

        </div>

    </div>
</div>